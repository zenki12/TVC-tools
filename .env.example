# Moi user nhap Gemini API key trong module Bien ban; key khong luu trong .env.

# Express API; Vite dev proxy tu dung cung gia tri nay.
PORT=3001

# Ma quan tri phan Background cua module Thiep sinh nhat.
# Nguoi dung thuong khong can ma nay; chi nguoi them/sua/xoa nen dung chung moi can.
BACKGROUND_ADMIN_PIN=change-me

# Production tren Vercel: tao Vercel Blob store va cau hinh token nay trong Project Settings.
# Local dev khong bat buoc; app se dung .data/birthday-backgrounds.json.
BLOB_READ_WRITE_TOKEN=
